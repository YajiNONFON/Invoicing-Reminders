generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String
  createdAt DateTime  @default(now())
  invoices  Invoice[]
}

model Invoice {
  id         String        @id @default(uuid())
  number     String        @unique
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  issueDate  DateTime      @db.Date
  dueDate    DateTime      @db.Date
  status     InvoiceStatus @default(draft)
  totalCents Int
  createdAt  DateTime      @default(now())
  lines      InvoiceLine[]
  payments   Payment[]

  @@index([clientId])
  @@index([status, dueDate])
}

model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantity       Int
  unitPriceCents Int

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountCents Int
  paidAt      DateTime @default(now())

  @@index([invoiceId])
}

model Sequence {
  name  String @id
  value Int    @default(0)
}